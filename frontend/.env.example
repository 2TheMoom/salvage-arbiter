# GenLayer RPC URL override (optional)
# Leave unset to use the selected chain's own built-in RPC (see lib/genlayer/chains.ts)
# NEXT_PUBLIC_GENLAYER_RPC_URL=

# GenLayer Network Configuration
# 4221 = Bradbury testnet (where RecoveryArbiter is deployed), 61999 = Studio
NEXT_PUBLIC_GENLAYER_CHAIN_ID=4221
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Bradbury Testnet
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# RecoveryArbiter contract address
# Live deployment on Bradbury testnet; replace with your own if you redeploy
NEXT_PUBLIC_CONTRACT_ADDRESS=0x228a8083aBc7961bef6cAeC2C0f19F288A3c5D03
